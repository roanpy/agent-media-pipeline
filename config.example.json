{
  "baseDir": "$HOME/MediaDownloader",
  "stateDir": "$HOME/MediaDownloader/.state",
  "downloadDir": "$HOME/MediaDownloader/Incoming",
  "timeoutHours": 24,
  "btStopTimeoutSeconds": 600,
  "minMediaDurationSeconds": 120,
  "defaultProfiles": {
    "tv": "tv1080",
    "movie": "movie1080"
  },
  "defaultModes": {
    "tv": "transcode",
    "movie": "transcode"
  },
  "defaultNaming": "plex",
  "targets": {},
  "namingPresets": {
    "plex": {
      "tv": {
        "showDir": "{canonical}",
        "seasonDir": "Season {season:02d}",
        "episodeFile": "{canonical} - S{season:02d}E{episode:02d}{episodeTitleSuffix}.{ext}"
      },
      "movie": {
        "showDir": "{canonical}",
        "movieFile": "{canonical}.{ext}"
      }
    }
  },
  "profiles": {
    "tv720": {
      "type": "tv",
      "label": "TV 720p H.264",
      "container": "mp4",
      "resolution": 720,
      "videoCodec": "libx264",
      "crf": 21,
      "audioCodec": "aac",
      "audioBitrate": "160k",
      "preset": "medium",
      "naming": "plex"
    },
    "tv1080": {
      "type": "tv",
      "label": "TV 1080p H.264",
      "container": "mp4",
      "resolution": 1080,
      "videoCodec": "libx264",
      "crf": 20,
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "preset": "medium",
      "naming": "plex"
    },
    "movie720": {
      "type": "movie",
      "label": "Movie 720p H.264",
      "container": "mp4",
      "resolution": 720,
      "videoCodec": "libx264",
      "crf": 20,
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "preset": "medium",
      "naming": "plex"
    },
    "movie1080": {
      "type": "movie",
      "label": "Movie 1080p H.264",
      "container": "mp4",
      "resolution": 1080,
      "videoCodec": "libx264",
      "crf": 18,
      "audioCodec": "aac",
      "audioBitrate": "256k",
      "preset": "medium",
      "naming": "plex"
    },
    "movie1080-mkv": {
      "type": "movie",
      "label": "Movie 1080p H.264 MKV (keeps embedded subtitles)",
      "container": "mkv",
      "resolution": 1080,
      "videoCodec": "libx264",
      "crf": 18,
      "audioCodec": "aac",
      "audioBitrate": "256k",
      "preset": "medium",
      "naming": "plex"
    },
    "tv1080-mkv": {
      "type": "tv",
      "label": "TV 1080p H.264 MKV (keeps embedded subtitles)",
      "container": "mkv",
      "resolution": 1080,
      "videoCodec": "libx264",
      "crf": 20,
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "preset": "medium",
      "naming": "plex"
    }
  },
  "searchSources": {
    "jackett": {
      "type": "jackett",
      "enabled": false,
      "url": "http://127.0.0.1:9117",
      "indexer": "all",
      "apiKeyEnv": "JACKETT_API_KEY",
      "categories": [],
      "timeoutSeconds": 90
    },
    "prowlarr": {
      "type": "torznab",
      "enabled": false,
      "url": "http://127.0.0.1:9696/1/api",
      "apiKeyEnv": "PROWLARR_API_KEY",
      "categories": [],
      "timeoutSeconds": 90
    },
    "web": {
      "type": "web",
      "enabled": true,
      "urlTemplate": "https://www.google.com/search?q={query}"
    }
  },
  "metadata": {
    "provider": "tmdb",
    "apiKeyEnv": "TMDB_API_KEY",
    "language": "zh-CN",
    "subtitleLanguages": "zh-CN,en",
    "tvFallback": "tvmaze",
    "requireArtwork": true
  },
  "customWords": {
    "ignore": ["全39集", "更新至"],
    "replace": [{"from": "第12话", "to": "E12"}],
    "episodeOffset": [{"pattern": "(?i)shows?-name", "offset": 50}]
  }
}
